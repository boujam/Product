{
  "$schema" : "https://json-schema.org/draft/2019-09/schema",
  "type" : "object",
  "properties" : {
    "description" : {
      "type" : "string",
      "maxLength" : 1000
    },
    "name" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "price" : {
      "type" : "number",
      "minimum" : 0
    },
    "productType" : {
      "type" : "string"
    }
  },
  "required" : [ "name", "price" ]
}