{
  "$schema" : "https://json-schema.org/draft/2019-09/schema",
  "type" : "object",
  "properties" : {
    "ageRating" : {
      "type" : "string",
      "minLength" : 1,
      "pattern" : "^PEGI (3|7|12|16|18)$"
    },
    "description" : {
      "type" : "string",
      "maxLength" : 1000
    },
    "developer" : {
      "type" : "string",
      "minLength" : 1
    },
    "genre" : {
      "type" : "string",
      "minLength" : 1
    },
    "id" : {
      "type" : "integer"
    },
    "name" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "platform" : {
      "type" : "string",
      "minLength" : 1
    },
    "price" : {
      "type" : "number",
      "minimum" : 0
    },
    "productType" : {
      "type" : "string"
    }
  },
  "required" : [ "ageRating", "developer", "genre", "id", "name", "platform", "price" ]
}