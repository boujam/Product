{
  "$schema" : "https://json-schema.org/draft/2019-09/schema",
  "type" : "object",
  "properties" : {
    "description" : {
      "type" : "string",
      "maxLength" : 1000
    },
    "director" : {
      "type" : "string",
      "minLength" : 1
    },
    "duration" : {
      "type" : "integer",
      "minimum" : 1,
      "maximum" : 600
    },
    "name" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "price" : {
      "type" : "number",
      "minimum" : 0
    },
    "productType" : {
      "type" : "string"
    },
    "releaseYear" : {
      "type" : "integer",
      "minimum" : 1888
    }
  },
  "required" : [ "director", "duration", "name", "price", "releaseYear" ]
}