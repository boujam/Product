{
  "$schema" : "https://json-schema.org/draft/2019-09/schema",
  "type" : "object",
  "properties" : {
    "author" : {
      "type" : "string",
      "minLength" : 1
    },
    "description" : {
      "type" : "string",
      "maxLength" : 1000
    },
    "isbn" : {
      "type" : "string",
      "minLength" : 1,
      "pattern" : "^\\d{10,13}$"
    },
    "name" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "numberOfPages" : {
      "type" : "integer",
      "minimum" : 1
    },
    "price" : {
      "type" : "number",
      "minimum" : 0
    },
    "productType" : {
      "type" : "string"
    },
    "publisher" : {
      "type" : "string",
      "minLength" : 1
    }
  },
  "required" : [ "author", "isbn", "name", "numberOfPages", "price", "publisher" ]
}