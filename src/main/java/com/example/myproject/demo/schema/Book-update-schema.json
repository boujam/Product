{
  "$schema" : "https://json-schema.org/draft/2019-09/schema",
  "type" : "object",
  "properties" : {
    "author" : {
      "type" : "string"
    },
    "description" : {
      "type" : "string"
    },
    "id" : {
      "type" : "integer"
    },
    "isbn" : {
      "type" : "string"
    },
    "name" : {
      "type" : "string"
    },
    "numberOfPages" : {
      "type" : "integer"
    },
    "price" : {
      "type" : "number",
      "minimum" : 0
    },
    "productType" : {
      "type" : "string"
    },
    "publisher" : {
      "type" : "string"
    }
  },
  "required" : [ "name", "price" ]
}